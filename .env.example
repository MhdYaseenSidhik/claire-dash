# SAP HANA connection settings for scripts/list_hana_tables.py
# Copy to .env and fill in real values (.env is gitignored).

# HANA Cloud host, e.g. <instance-id>.hna0.prod-us10.hanacloud.ondemand.com
HANA_HOST=
# Port — 443 for HANA Cloud (TLS)
HANA_PORT=443
# Database user
HANA_USER=
# Database password
HANA_PASSWORD=
# Use TLS — required for HANA Cloud (leave "true")
HANA_ENCRYPT=true
